{
  "name": "@agentic-readiness/core",
  "version": "0.10.0",
  "description": "The Agentic Readiness Scanner engine: fetcher, target resolver, parsers, checks, runner, scoring and reporters, with the catalog and visual system bundled in.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatthiasReinholz/agentic-readiness-scanner.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/MatthiasReinholz/agentic-readiness-scanner#readme",
  "bugs": {
    "url": "https://github.com/MatthiasReinholz/agentic-readiness-scanner/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "fast-xml-parser": "5.11.2",
    "htmlparser2": "12.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentic-readiness/catalog": "workspace:*",
    "@agentic-readiness/ui": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
