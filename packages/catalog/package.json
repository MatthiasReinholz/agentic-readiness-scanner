{
  "name": "@agentic-readiness/catalog",
  "version": "0.1.0",
  "description": "The check catalog: check definitions, scoring levels, profiles, fixes and the versioned result schema, as data.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./schema/*.json": "./dist/schema/*.json"
  },
  "files": [
    "dist",
    "data",
    "fixes"
  ],
  "scripts": {
    "build": "tsx src/build.ts && tsc -p tsconfig.build.json",
    "validate": "tsx src/build.ts --check",
    "docs": "tsx src/docs.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
