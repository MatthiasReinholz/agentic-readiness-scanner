{
  "name": "@agentic-readiness/ui",
  "version": "0.2.0",
  "description": "The visual system shared by the HTML report and the hosted app: design tokens, the compiled Tailwind stylesheet and the component class recipes.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatthiasReinholz/agentic-readiness-scanner.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/MatthiasReinholz/agentic-readiness-scanner#readme",
  "bugs": {
    "url": "https://github.com/MatthiasReinholz/agentic-readiness-scanner/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-assets.mjs && tsc -p tsconfig.build.json",
    "build:assets": "node scripts/build-assets.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-static": "1.66.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
