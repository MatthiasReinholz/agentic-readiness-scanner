{
  "name": "@agentic-readiness/cli",
  "version": "0.18.1",
  "description": "Command line and local MCP server of the Agentic Readiness Scanner, self-contained: npx @agentic-readiness/cli scan <url>.",
  "keywords": [
    "agentic-commerce",
    "ai-agents",
    "readiness",
    "scanner",
    "cli",
    "mcp",
    "mcp-server",
    "ucp",
    "acp",
    "structured-data",
    "robots-txt",
    "ecommerce",
    "woocommerce",
    "shopify",
    "seo"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatthiasReinholz/agentic-readiness-scanner.git",
    "directory": "packages/cli"
  },
  "homepage": "https://agentic-readiness-scanner.space.fast/",
  "bugs": {
    "url": "https://github.com/MatthiasReinholz/agentic-readiness-scanner/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "agentic-readiness": "./bin/agentic-readiness.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "fast-xml-parser": "5.11.2",
    "htmlparser2": "12.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentic-readiness/catalog": "workspace:*",
    "@agentic-readiness/core": "workspace:*",
    "@agentic-readiness/mcp": "workspace:*",
    "@agentic-readiness/ui": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
