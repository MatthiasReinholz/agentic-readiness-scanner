{
  "$schema": "https://spacefast.com/schema/sf.json",
  // Set after the first `sf publish` creates the Space, or via SPACEFAST_SPACE in CI.
  // "space": "agentic-readiness",
  "name": "Agentic Readiness Scanner",
  "meta": {
    "title": "Agentic Readiness Scanner",
    "description": "Can an AI agent find, read, trust and buy from your store? Scan any URL.",
  },
  "runtime": {
    "kind": "functions",
    "entry": "handler.js",
    "compatibilityDate": "2026-07-01",
  },
  "crons": [{ "path": "/internal/cron/cleanup", "schedule": "daily" }],
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      ],
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"llms-txt\"; type=\"text/markdown\", </.well-known/mcp/server-card.json>; rel=\"mcp-server\"; type=\"application/json\"",
        },
      ],
    },
  ],
  "access": "public",
}
