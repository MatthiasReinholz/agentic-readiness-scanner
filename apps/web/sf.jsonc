{
  "$schema": "https://spacefast.com/schema/sf.json",
  // Runtime configuration, copied to dist/ by build.mjs. Build settings for the connected
  // repository live in the repository-root sf.jsonc.
  // The Space is bound through the GitHub integration; set "space" only for a manual
  // `sf publish` from a machine that is not linked yet.
  // "space": "agentic-readiness",
  "name": "Agentic Readiness Scanner",
  "meta": {
    "title": "Agentic Readiness Scanner",
    "description": "Can an AI agent find, read, trust and buy from your store? Scan any URL.",
  },
  "runtime": {
    "kind": "functions",
    "entry": "handler.js",
    "compatibilityDate": "2026-07-01",
  },
  "crons": [{ "path": "/internal/cron/cleanup", "schedule": "daily" }],
  // Response headers are set by the worker (apps/web/src/app.ts); sf.jsonc header rules
  // apply to static files only.
  "access": "public",
}
