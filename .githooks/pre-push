#!/usr/bin/env bash
# Local push gate: mirrors the fast part of CI so avoidable failures never reach GitHub.
# Bypass intentionally with ARS_SKIP_PUSH_GATE=1.
set -euo pipefail

if [ "${ARS_SKIP_PUSH_GATE:-}" = "1" ]; then
  echo "Skipping local push gate because ARS_SKIP_PUSH_GATE=1"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"
echo "Running local push gate: pnpm check"
pnpm check
echo "Local push gate passed."
